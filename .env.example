# Example environment variables for SIAR-TFG
# Copy this file to ".env" and edit values as needed before running the app

# Secret key for Flask sessions/forms (replace with a secure random value)
SECRET_KEY=change-me-to-a-strong-secret

# Database URL: replace password and user if needed
# Format: postgresql://usuario:contraseña@host:puerto/nombre_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tfg_db

# Optional: enable debug mode (True/False)
FLASK_DEBUG=True
# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y completa con tus valores reales
# NUNCA subas el archivo .env al repositorio

# Clave secreta para Flask (genera una clave segura y unica)
# Puedes generar una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu-clave-secreta-muy-dificil-de-adivinar-cambiala-por-algo-seguro

# URL de conexion a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_db
# IMPORTANTE: Reemplaza los valores de ejemplo con tus credenciales reales
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/tfg_db

# Configuracion de Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True

# Para produccion, cambia a:
# FLASK_ENV=production
# FLASK_DEBUG=False
